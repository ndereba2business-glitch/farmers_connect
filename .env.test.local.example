# Logins for `npm run test:live` (real-database end-to-end tests).
#
# 1. In the app, sign up one test SUPPLIER account and one test FARMER
#    account (use addresses you control; they are real accounts).
# 2. Copy this file to .env.test.local and fill in the values below.
#    .env.test.local is gitignored (*.local). Never commit real logins.
#
# The live tests create one product named "E2E live <time>" under the test
# supplier, record one farmer contact, and delete the product at the end.

TEST_SUPPLIER_EMAIL=
TEST_SUPPLIER_PASSWORD=
TEST_FARMER_EMAIL=
TEST_FARMER_PASSWORD=
