{
  "name": "farmersconnect",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "test:e2e": "node --test --test-concurrency=1 tests/e2e/supplier-dashboard.test.js tests/e2e/onboarding.test.js tests/e2e/google-sign-in.test.js tests/e2e/gallery.test.js tests/e2e/feed-calculator.test.js tests/e2e/community.test.js tests/e2e/notifications.test.js",
    "test:live": "node --test --test-concurrency=1 tests/e2e/live.test.js",
    "test:security": "node scripts/test-security.mjs",
    "check:secrets": "vite build && node scripts/check-secrets.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.4",
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.1",
    "recharts": "^3.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "playwright": "^1.63.0",
    "vite": "^8.0.12"
  }
}
